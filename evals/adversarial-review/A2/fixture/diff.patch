+      "label": "an ls-remote failure fails open as 'nothing pushed' instead of skipping",
+      "file": "../sync_boundary_squash.py",
+      "oracle": "real",
+      "find": "    try:\n        remote_head = _ls_remote_head(remote, branch)\n    except GitError as exc:\n        report.reason = f\"fresh ls-remote failed ({exc}); cannot verify pushed-ness\"\n        return report",
+      "replace": "    try:\n        remote_head = _ls_remote_head(remote, branch)\n    except GitError:\n        remote_head = None"
+    },
+    {
+      "label": "net-empty unpushed run no longer skips, so the boundary invents or fails a commit",
+      "file": "../sync_boundary_squash.py",
+      "oracle": "real",
+      "find": "    old_tree = _git_out(\"rev-parse\", f\"{head}^{{tree}}\")\n    if _git_out(\"rev-parse\", f\"{squash_base}^{{tree}}\") == old_tree:\n        report.squash_base = None\n        report.reason = \"unpushed commits are net-empty; a squash would need an empty commit\"\n        return report",
+      "replace": "    old_tree = _git_out(\"rev-parse\", f\"{head}^{{tree}}\")"
+    },
+    {
+      "label": "detached HEAD no longer skips: the branch is guessed from --abbrev-ref",
