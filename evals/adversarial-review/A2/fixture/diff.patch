+      "replace": "    branch = _git_out(\"rev-parse\", \"--abbrev-ref\", \"HEAD\")"
+    },
+    {
+      "label": "a base that is not an ancestor of HEAD no longer skips the squash",
+      "file": "../sync_boundary_squash.py",
+      "oracle": "real",
+      "find": "    if not _is_ancestor(base, head):\n        report.reason = f\"base {base[:12]} is not an ancestor of HEAD\"\n        return report\n",
+      "replace": ""
+    },
+    {
+      "label": "interleaved pushed/unpushed classification guesses a prefix instead of refusing",
+      "file": "../sync_boundary_squash.py",
+      "oracle": "real",
+      "find": "    if any(pushed_flags[first_unpushed:]):\n        return None\n    return first_unpushed",
+      "replace": "    return first_unpushed"
+    },
+    {
+      "label": "[control] reorder the action and reason writes on the success report",
