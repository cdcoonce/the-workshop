{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "tests/test_gitlab_mr_create_script.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_gitlab_mr_create_script.py"
  ],
  "mutants": [
    {
      "label": "dev hop refuses a title file again",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "if [[ -n \"$title_file\" ]]; then\n  [[ -f",
      "replace": "if [[ -n \"$title_file\" ]]; then\n  requires_title_file \"$target_branch\" || exit 64\n  [[ -f"
    },
    {
      "label": "conventional-commit gate checks only the HEAD subject",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "if ! requires_title_file \"$target_branch\"; then",
      "replace": "if ! requires_title_file \"$target_branch\" && [[ -z \"$title_file\" ]]; then"
    },
    {
      "label": "single-line check applies only on promotion hops",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "[[ \"$expected_title\" != *$'\\n'* ]] ||",
      "replace": "! requires_title_file \"$target_branch\" || [[ \"$expected_title\" != *$'\\n'* ]] ||"
    },
    {
      "label": "dev hop accepts the flag but still titles from HEAD",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "double",
      "find": "  title_source=\"Title file\"",
      "replace": "  title_source=\"Title file\"\n  requires_title_file \"$target_branch\" || expected_title=$(git log -1 --format=%s)"
    },
    {
      "label": "read-back skips the title when a title file titles a dev MR",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "double",
      "find": "[[ \"$actual_title\" == \"$expected_title\" ]] ||",
      "replace": "[[ -n \"$title_file\" ]] && ! requires_title_file \"$target_branch\" || [[ \"$actual_title\" == \"$expected_title\" ]] ||"
    },
    {
      "label": "an empty spaced --title-file reads as absent",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "[[ -n \"${2-}\" ]] || { printf -- '--title-file needs a path.\\n' >&2; exit 64; }",
      "replace": "[[ $# -ge 2 ]] || { printf -- '--title-file needs a path.\\n' >&2; exit 64; }"
    },
    {
      "label": "an empty --title-file= reads as absent",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "      [[ -n \"$title_file\" ]] || { printf -- '--title-file needs a path.\\n' >&2; exit 64; }\n",
      "replace": ""
    },
    {
      "label": "the dev hop never runs the sweep, so a surviving rename opens the MR",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "    if ! sweep_output=$(python3 \"$preflight\" sweep --base \"$sweep_base\" 2>&1); then",
      "replace": "    if false; then"
    },
    {
      "label": "a missing origin/<target> warns and sweeps nothing instead of refusing",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "      exit 65\n    }\n    sweep_base=$(git merge-base HEAD \"origin/$target_branch\")",
      "replace": "    }\n    sweep_base=$(git merge-base HEAD \"origin/$target_branch\" 2>/dev/null || git rev-parse HEAD)"
    },
    {
      "label": "every non-promotion target is swept, not only dev",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "  if [[ \"$target_branch\" == dev ]]; then",
      "replace": "  if true; then"
    },
    {
      "label": "the dev hop sweeps without the description, so every waiver is ignored",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "sweep --base \"$sweep_base\" --description \"$rendered_file\" --update 2>&1",
      "replace": "sweep --base \"$sweep_base\" 2>&1"
    },
    {
      "label": "the MR is created from the author's file, so the sweep block never ships",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "    description_source=$rendered_file\n",
      "replace": "    description_source=$description_file\n"
    },
    {
      "label": "the sweep renders into the author's file instead of a copy",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "sweep --base \"$sweep_base\" --description \"$rendered_file\" --update 2>&1",
      "replace": "sweep --base \"$sweep_base\" --description \"$description_file\" --update 2>&1"
    },
    {
      "label": "a refusal leaves out how to write the to-do list into the description",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "find": "      printf 'To write the open references into %s as a to-do list:\\n  python3 %q sweep --base %s --description %q --update\\n' \\\n        \"$description_file\" \"$preflight\" \"$sweep_base\" \"$description_file\" >&2\n",
      "replace": ""
    },
    {
      "label": "[control] reword the HEAD-subject label in the gate's error",
      "file": "../plugins/workbench/skills/gitlab-mr-create/scripts/create-mr",
      "oracle": "real",
      "expect": "survived",
      "why": "The label only feeds the stderr text printed when a HEAD subject fails the dev-hop gate; exit code, creation and the title handed to glab are unchanged on every path. No test asserts that message's wording (the --title-file stderr assertions are on the promotion-hop refusal, a different printf), so the suite should hold green. It is not inert to a human reader, who sees the reworded message.",
      "find": "  title_source=\"HEAD subject\"",
      "replace": "  title_source=\"HEAD commit subject\""
    }
  ]
}
