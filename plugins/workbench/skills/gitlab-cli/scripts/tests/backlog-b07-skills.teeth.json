{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "plugins/workbench/skills/gitlab-cli/scripts/tests/test_glab.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "plugins/workbench/skills/gitlab-cli/scripts/tests/test_glab.py"
  ],
  "mutants": [
    {
      "label": "#1144 pagination stops after the first page",
      "file": "../_glab.py",
      "find": "        if len(data) < PAGE_SIZE:\n            return entries",
      "replace": "        if True:\n            return entries",
      "oracle": "real"
    },
    {
      "label": "#1144 page-cap exhaustion returns the partial list",
      "file": "../_glab.py",
      "find": "            return entries\n    return None\n\n\ndef parse_project_path",
      "replace": "            return entries\n    return entries\n\n\ndef parse_project_path",
      "oracle": "real"
    },
    {
      "label": "#1144 mid-pagination failure returns the partial list",
      "file": "../_glab.py",
      "find": "        if not isinstance(data, list):\n            return None",
      "replace": "        if not isinstance(data, list):\n            return entries",
      "oracle": "real"
    },
    {
      "label": "#1144 query separator always ?",
      "file": "../_glab.py",
      "find": "    separator = \"&\" if \"?\" in path else \"?\"",
      "replace": "    separator = \"?\"",
      "oracle": "real"
    },
    {
      "label": "#1144 URL-form remotes not parsed",
      "file": "../_glab.py",
      "find": "    if \"://\" in url:",
      "replace": "    if False:",
      "oracle": "real"
    },
    {
      "label": "#1144 .git suffix kept",
      "file": "../_glab.py",
      "find": "    if path.endswith(\".git\"):",
      "replace": "    if False:",
      "oracle": "real"
    },
    {
      "label": "1144 stop condition <= PAGE_SIZE",
      "file": "../_glab.py",
      "find": "if len(data) < PAGE_SIZE:",
      "replace": "if len(data) <= PAGE_SIZE:",
      "oracle": "real"
    },
    {
      "label": "1144 page range off by one (MAX_PAGES-1 pages)",
      "file": "../_glab.py",
      "find": "range(1, MAX_PAGES + 1)",
      "replace": "range(1, MAX_PAGES)",
      "oracle": "real"
    },
    {
      "label": "1144 page range one extra",
      "file": "../_glab.py",
      "find": "range(1, MAX_PAGES + 1)",
      "replace": "range(1, MAX_PAGES + 2)",
      "oracle": "real"
    },
    {
      "label": "1144 page starts at 0",
      "file": "../_glab.py",
      "find": "range(1, MAX_PAGES + 1)",
      "replace": "range(0, MAX_PAGES)",
      "oracle": "real"
    },
    {
      "label": "1144 per_page dropped",
      "file": "../_glab.py",
      "find": "per_page={PAGE_SIZE}&page={page}",
      "replace": "page={page}",
      "oracle": "real"
    },
    {
      "label": "1144 scp path keeps leading colon part (split rsplit)",
      "file": "../_glab.py",
      "find": "url.split(\":\", 1)[1]",
      "replace": "url.rsplit(\":\", 1)[1]",
      "oracle": "real"
    },
    {
      "label": "1144 strip only trailing slash type (no leading strip)",
      "file": "../_glab.py",
      "find": "path.strip(\"/\")",
      "replace": "path.rstrip(\"/\")",
      "oracle": "real"
    },
    {
      "label": "1144 empty path returns ''",
      "file": "../_glab.py",
      "find": "return path or None",
      "replace": "return path",
      "oracle": "real"
    },
    {
      "label": "1144 no-colon no-scheme returns whole url",
      "file": "../_glab.py",
      "find": "    else:\n        return None\n    path = path.strip",
      "replace": "    else:\n        path = url\n    path = path.strip",
      "oracle": "real"
    }
  ]
}
