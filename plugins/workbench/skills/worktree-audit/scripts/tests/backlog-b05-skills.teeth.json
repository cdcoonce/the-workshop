{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "tests"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "tests"
  ],
  "mutants": [
    {
      "label": "reap skips the removed-worktree count when the branch delete fails (#749)",
      "file": "../worktree_audit.py",
      "oracle": "real",
      "find": "                worktree_gone = True\n",
      "replace": "                pass\n"
    },
    {
      "label": "reap swallows the branch-delete failure without a diagnostic (#749)",
      "file": "../worktree_audit.py",
      "oracle": "real",
      "find": "                file=sys.stderr,\n",
      "replace": "                file=sys.stdout,\n"
    },
    {
      "label": "reap counts a worktree whose removal failed (#749)",
      "file": "../worktree_audit.py",
      "oracle": "real",
      "find": "                worktree_gone = True\n        except (subprocess.CalledProcessError, OSError):\n            continue\n",
      "replace": "                worktree_gone = True\n        except (subprocess.CalledProcessError, OSError):\n            pass\n"
    },
    {
      "label": "find_repos lists every ordinary checkout again (#611)",
      "file": "../worktree_audit.py",
      "oracle": "real",
      "find": "            if list_worktrees(child):",
      "replace": "            if list_worktrees(child) or (child / \".git\").is_dir():"
    },
    {
      "label": "reap counts an orphan branch whose delete failed (#749, independent pass)",
      "file": "../worktree_audit.py",
      "oracle": "real",
      "find": "            if not worktree_gone:\n                continue\n",
      "replace": "            if False:\n                continue\n"
    }
  ]
}
