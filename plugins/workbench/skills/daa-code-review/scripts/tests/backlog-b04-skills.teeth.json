{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "tests/test_markdown_analyzer.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_markdown_analyzer.py"
  ],
  "mutants": [
    {
      "label": "#608: the right-curly-quote entry is missing from the corruption map (test_curly_double_quote_keys_map_to_curly_quotes)",
      "file": "../markdown_analyzer.py",
      "oracle": "real",
      "find": "    \"\\u00e2\\u20ac\\x9d\": \"\\u201d\",  # right double quote",
      "replace": "    # right double quote entry dropped"
    },
    {
      "label": "#608: the left-curly-quote entry fixes to a straight quote (test_corrupted_curly_quotes_suggest_proper_curly_quotes)",
      "file": "../markdown_analyzer.py",
      "oracle": "real",
      "find": "    \"\\u00e2\\u20ac\\u0153\": \"\\u201c\",  # left double quote",
      "replace": "    \"\\u00e2\\u20ac\\u0153\": \"\\\"\",  # left double quote"
    },
    {
      "label": "#748: defined_refs is built from unmasked content again (test_defined_ref_inside_code_fence_does_not_define_it)",
      "file": "../markdown_analyzer.py",
      "oracle": "real",
      "find": "REFERENCE_DEF_PATTERN.finditer(masked_content)",
      "replace": "REFERENCE_DEF_PATTERN.finditer(content)"
    },
    {
      "label": "#748: defined_refs keeps its original case (test_reference_label_case_differs_between_definition_and_use)",
      "file": "../markdown_analyzer.py",
      "oracle": "real",
      "find": "            m.group(1).lower()",
      "replace": "            m.group(1)"
    },
    {
      "label": "#608: the corruption map loses or merges an entry (test_corruption_map_has_the_expected_entry_count)",
      "file": "../markdown_analyzer.py",
      "oracle": "real",
      "find": "    \"\\u00e2\\u20ac\\u02dc\": \"'\",  # left single quote",
      "replace": "    # left single quote dropped"
    }
  ]
}
