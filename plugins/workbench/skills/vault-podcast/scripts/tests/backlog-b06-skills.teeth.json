{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "tests"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "tests"
  ],
  "mutants": [
    {
      "label": "[#796] non-finite PAUSE not rejected (test_pause_non_finite_raises)",
      "file": "../render.py",
      "oracle": "real",
      "find": "    if not math.isfinite(seconds):",
      "replace": "    if False:"
    }
  ]
}
