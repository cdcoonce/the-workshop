#!/usr/bin/env bash
set -euo pipefail

# The title rule depends on which hop this merge request is. Into the shared
# integration branch, one branch carries one concern and its title is a
# conventional commit naming it: the HEAD subject by default, which is right
# for a one-commit branch (154 of 208 merge requests into `dev` across six
# Clearway repos, 2026-09-24), or a title file on a multi-commit branch, whose
# HEAD is its last slice (only 17 of the other 54 carry the HEAD subject).
# The promotion into `main` is the opposite: 6 of 6 across every Clearway
# repo carry a descriptive title, because the subject at the head of a release
# branch is the release bot's `chore(release): vX.Y.Z`. That subject satisfies
# the conventional-commit gate, so deriving the title from it does not fail
# loudly on a promotion — it succeeds, and names a production release after a
# chore. Hence the routing below: the title file is required on a promotion
# hop, and optional but still gated into `dev`.
#
# `main` is the release branch throughout these repos (see the
# `gitlab-promotion-flow` skill). `staging`, where a repo's own CLAUDE.md
# declares the dev -> staging -> main cadence (that skill's staging-cadence
# reference), is refreshed from `dev` itself, so HEAD is whatever last landed
# on dev: a merge commit — `Merge branch 'X' into 'dev'`, which no one can
# amend on a protected branch — or, where a release bot commits after every
# merge, its `chore(release): vX.Y.Z`, which passes the gate and mis-titles
# the refresh exactly as it would a promotion.
requires_title_file() {
  case "$1" in
    main|staging) return 0 ;;
    *) return 1 ;;
  esac
}

usage() {
  printf 'Usage: %s DESCRIPTION.md [--title-file TITLE.txt] [glab mr create options]\n' "${0##*/}" >&2
  exit 64
}
[[ $# -ge 1 ]] || usage
description_file=$1
shift
[[ -f "$description_file" && -s "$description_file" ]] || { printf 'Description file must exist and be non-empty: %s\n' "$description_file" >&2; exit 66; }

for command in glab git jq; do
  command -v "$command" >/dev/null || { printf '%s is required.\n' "$command" >&2; exit 69; }
done

# One pass over the arguments: reject the flags the guard owns, consume
# `--title-file` so it never reaches glab, and note the target branch in every
# spelling glab accepts. Missing a spelling would route a promotion down the
# integration path, which is the defect this guard exists to prevent.
title_file=""
target_branch=""
forward=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title|--title=*|-t|-t*|--description|--description=*|-d|-d*)
      printf 'Do not supply %s; the guard owns title and description.\n' "$1" >&2; exit 64 ;;
    --title-file)
      [[ $# -ge 2 ]] || { printf '--title-file needs a path.\n' >&2; exit 64; }
      title_file=$2; shift 2; continue ;;
    --title-file=*)
      title_file=${1#--title-file=}; shift; continue ;;
    --target-branch|-b)
      target_branch=${2-} ;;
    --target-branch=*)
      target_branch=${1#--target-branch=} ;;
    -b?*)
      target_branch=${1#-b} ;;
  esac
  forward+=("$1")
  shift
done

# With no explicit flag glab targets the project's default branch, which in
# some of these repos is `main`. Resolving it keeps a promotion on the
# promotion path when the flag is simply left off.
if [[ -z "$target_branch" ]]; then
  target_branch=$(glab api "projects/:id" | jq -r '.default_branch // empty') || true
  [[ -n "$target_branch" ]] || { printf 'Could not resolve the target branch; pass --target-branch explicitly.\n' >&2; exit 65; }
fi

if requires_title_file "$target_branch" && [[ -z "$title_file" ]]; then
  printf 'A merge request into %s needs --title-file: the HEAD subject (%s) titles the branch head, not the hop.\n' "$target_branch" "$(git log -1 --format=%s)" >&2
  printf 'Write the title to a file and pass --title-file; amending HEAD is not the remedy on a frozen or protected branch.\n' >&2
  exit 65
fi

if [[ -n "$title_file" ]]; then
  [[ -f "$title_file" && -s "$title_file" ]] || { printf 'Title file must exist and be non-empty: %s\n' "$title_file" >&2; exit 66; }
  # Read from the file, never from an argument: `!NNN` is GitLab's own
  # merge-request reference syntax and the most natural thing to write in a
  # promotion title, and a shell that expands history turns it into a stray
  # command (ERG !104 shipped with one baked into its title).
  expected_title=$(<"$title_file")
  [[ -n "$expected_title" ]] || { printf 'Title file is blank: %s\n' "$title_file" >&2; exit 65; }
  [[ "$expected_title" != *$'\n'* ]] || { printf 'Title must be a single line: %s\n' "$title_file" >&2; exit 65; }
  title_source="Title file"
else
  expected_title=$(git log -1 --format=%s)
  title_source="HEAD subject"
fi

# Into the integration branch the title is a conventional commit whichever
# source supplied it. HEAD's subject is the default because a one-commit
# branch's subject is its concern; a test-first branch ends on its last slice
# (IQ !82 ended on `test(pjm): commit the conformance mutation spec`), and
# amending that relabels a real commit, so the concern comes from a title file
# there instead — still held to the same gate.
if ! requires_title_file "$target_branch"; then
  conventional_commit_pattern='^[a-z]+(\([^)]+\))?!?: .+'
  [[ "$expected_title" =~ $conventional_commit_pattern ]] || { printf '%s is not a conventional commit: %s\n' "$title_source" "$expected_title" >&2; exit 65; }
fi

description=$(<"$description_file")
output_file=$(mktemp)
trap 'rm -f "$output_file"' EXIT
# `${forward[@]+...}` because bash 3.2 — the macOS system bash — treats an
# empty array as unset under `set -u`, while CI's bash 5 does not.
glab mr create --title "$expected_title" --description "$description" ${forward[@]+"${forward[@]}"} | tee "$output_file"
mr_url=$(grep -Eo 'https?://[^[:space:]]+/-/merge_requests/[0-9]+' "$output_file" | tail -n 1 || true)
[[ -n "$mr_url" ]] || { printf 'MR was created, but glab did not report its URL; verification could not run.\n' >&2; exit 70; }

mr_iid=${mr_url##*/}
mr_json=$(glab api "projects/:id/merge_requests/$mr_iid")
actual_title=$(jq -r '.title' <<<"$mr_json")
actual_description=$(jq -r '.description // ""' <<<"$mr_json")
[[ "$actual_title" == "$expected_title" ]] || { printf 'Verification failed: title differs.\n' >&2; exit 1; }
[[ "$actual_description" == "$description" ]] || { printf 'Verification failed: description differs from %s.\n' "$description_file" >&2; exit 1; }
printf 'Verified %s: title and Markdown description match.\n' "$mr_url"
