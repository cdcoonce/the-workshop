{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "-q",
    "plugins/workbench/skills/dbt-manifest-facts/scripts/tests"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "plugins/workbench/skills/dbt-manifest-facts/scripts/tests"
  ],
  "mutants": [
    {
      "label": "orphans stops considering sources (#787)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "    candidates += [(uid, node) for uid, node in manifest.get(\"sources\", {}).items()]\n",
      "replace": "    candidates += []\n"
    },
    {
      "label": "stale_sources ignores dbt_project.yml entirely (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "    custom = _project_ignored_paths(project_dir)",
      "replace": "    custom = []"
    },
    {
      "label": "only target-path is read, packages-install-path is dropped (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "for key in _PATH_KEYS:",
      "replace": "for key in _PATH_KEYS[:1]:"
    },
    {
      "label": "a custom path hides every project file, not just its own subtree (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "relative[: len(prefix)] == prefix",
      "replace": "True"
    },
    {
      "label": "an undecodable dbt_project.yml raises instead of falling back (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "except (OSError, UnicodeDecodeError):",
      "replace": "except OSError:"
    },
    {
      "label": "custom paths are never read (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "    custom = _project_ignored_paths(project_dir)",
      "replace": "    custom = []"
    },
    {
      "label": "only target-path is honoured (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "_PATH_KEYS = (\"target-path\", \"packages-install-path\")",
      "replace": "_PATH_KEYS = (\"target-path\",)"
    },
    {
      "label": "only packages-install-path is honoured (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "_PATH_KEYS = (\"target-path\", \"packages-install-path\")",
      "replace": "_PATH_KEYS = (\"packages-install-path\",)"
    },
    {
      "label": "custom prefix matches the first segment only (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "relative[: len(prefix)] == prefix",
      "replace": "relative[0] == prefix[0]"
    },
    {
      "label": "ignored dirs tested against the absolute path (#1213)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "            if IGNORED_DIRS & set(relative):",
      "replace": "            if IGNORED_DIRS & set(candidate.parts):"
    },
    {
      "label": "custom path replaces the default ignores (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "            if IGNORED_DIRS & set(relative):",
      "replace": "            if not custom and IGNORED_DIRS & set(relative):"
    },
    {
      "label": "dot target-path guard removed (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "if not parts or Path(value)",
      "replace": "if Path(value)"
    },
    {
      "label": "key anchor removed so nested keys match (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "rf\"^{re.escape(key)}:",
      "replace": "rf\"{re.escape(key)}:"
    },
    {
      "label": "custom path matches exact dir only, not subtree (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "relative[: len(prefix)] == prefix",
      "replace": "relative[:-1] == prefix"
    },
    {
      "label": "first key found stops the scan (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "        found.append(parts)",
      "replace": "        found.append(parts)\n        break"
    },
    {
      "label": "inline comment strip ignores tabs (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "re.split(r\"(?:^|\\s)#\", raw, maxsplit=1)[0].strip()",
      "replace": "raw.split(\" #\")[0].strip()"
    },
    {
      "label": "quoted values are not read to their closing quote (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "        end = raw.find(raw[0], 1)\n",
      "replace": "        end = -1\n"
    },
    {
      "label": "BOM is not stripped when reading dbt_project.yml (#786)",
      "file": "../manifest_facts.py",
      "oracle": "real",
      "find": "encoding=\"utf-8-sig\"",
      "replace": "encoding=\"utf-8\""
    }
  ]
}
