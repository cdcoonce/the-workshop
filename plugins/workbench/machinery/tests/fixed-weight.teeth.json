{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "--with",
    "pyyaml",
    "--with",
    "hypothesis",
    "--with",
    "numpy",
    "python",
    "-m",
    "pytest",
    "-q",
    "test_fixed_weight.py",
    "test_transcript_reader.py",
    "test_cost_ledger.py",
    "test_cost_ledger_skills.py",
    "test_cost_ledger_export.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "--with",
    "pyyaml",
    "--with",
    "hypothesis",
    "--with",
    "numpy",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "test_fixed_weight.py",
    "test_transcript_reader.py",
    "test_cost_ledger.py",
    "test_cost_ledger_skills.py",
    "test_cost_ledger_export.py"
  ],
  "mutants": [
    {
      "label": "1 read call charged nothing",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "rate = priced.rates[\"cache_read\"]",
      "replace": "rate = 0.0"
    },
    {
      "label": "2 write never charged",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "if call.cache_write_tokens >= total_tokens:",
      "replace": "if False:"
    },
    {
      "label": "3 write needs strictly more than T",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "call.cache_write_tokens >= total_tokens:",
      "replace": "call.cache_write_tokens > total_tokens:"
    },
    {
      "label": "4 1-hour rate never used",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "if call.cache_write_1h_tokens >= total_tokens",
      "replace": "if False"
    },
    {
      "label": "5 file's first charged call always a write",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "if call.cache_write_tokens >= total_tokens:",
      "replace": "if call.cache_write_tokens >= total_tokens or key not in charged_files:"
    },
    {
      "label": "6 every call priced at the file's first call's rates",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "        priced = pricing.price_call(call, pricer.table)\n",
      "replace": "        priced = pricing.price_call(call, pricer.table)\n        _first = tokens.setdefault((\"first\",) + key, {\"p\": priced})[\"p\"]\n        priced = __import__(\"dataclasses\").replace(priced, rates=_first.rates)\n"
    },
    {
      "label": "7 out-of-window calls charged",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "collector.files, window_calls, pricer,",
      "replace": "collector.files, result.calls, pricer,"
    },
    {
      "label": "8 cap removed",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "if fixed > priced.total_usd * (1 + _CAP_SLACK):",
      "replace": "if False:"
    },
    {
      "label": "9 capped calls never counted",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "            capped += 1\n",
      "replace": "            capped += 0\n"
    },
    {
      "label": "10 attachments after the first call counted",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "        if state.called:\n            return\n        size = _rendered_size(rec)",
      "replace": "        size = _rendered_size(rec)"
    },
    {
      "label": "11 attachment sized by whole object not rendered text",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "size = _rendered_size(rec)",
      "replace": "size = len(json.dumps(att, separators=(\",\", \":\"), ensure_ascii=False))"
    },
    {
      "label": "12 tool sized by whole element not schema",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "size = len(json.dumps(schema, separators=(\",\", \":\"), ensure_ascii=False))",
      "replace": "size = len(json.dumps(tool, separators=(\",\", \":\"), ensure_ascii=False))"
    },
    {
      "label": "13 every tool counted as built-in",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "mcp = tool[\"name\"].startswith(_MCP_PREFIX)",
      "replace": "mcp = False"
    },
    {
      "label": "14 deferred listing all built-in",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "share = sum(n.startswith(_MCP_PREFIX) for n in usable) / len(usable) if usable else 0.0",
      "replace": "share = 0.0"
    },
    {
      "label": "15 hook_context in the claude_code group",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "(\"hook_context\", SETUP),",
      "replace": "(\"hook_context\", CLAUDE_CODE),"
    },
    {
      "label": "16 calibration factor ignored",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "chars / cpt * factor",
      "replace": "chars / cpt"
    },
    {
      "label": "17 characters multiplied by the ratio",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "chars / cpt * factor",
      "replace": "chars * cpt * factor"
    },
    {
      "label": "18 files without snapshot never counted",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "sum(1 for k in seen_files if not _has_snapshot(files, k))",
      "replace": "0"
    },
    {
      "label": "19 subagent file uses its parent's sizes",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "sizes = tokens.get(key, {})",
      "replace": "sizes = tokens.get((key[0], key[1], False, None), {})"
    },
    {
      "label": "20 subagent_usd reports the whole total",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "\"subagent_usd\": _r(subagent_usd),",
      "replace": "\"subagent_usd\": _r(total),"
    },
    {
      "label": "21 UNCALIBRATED line always printed",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "if not fw[\"calibrated\"]:",
      "replace": "if True:"
    },
    {
      "label": "22 invalid calibration file falls back to 1.0",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "            calibration = _fw.load_calibration(path, required=explicit)\n        except _fw.CalibrationError as exc:\n            return _fail(str(exc))",
      "replace": "            calibration = _fw.load_calibration(path, required=explicit)\n        except _fw.CalibrationError:\n            calibration = _fw.Calibration()"
    },
    {
      "label": "23 estimate computed without the flag",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "collector = _fw.Collector() if fixed_weight else None",
      "replace": "collector = _fw.Collector()"
    },
    {
      "label": "24 on_record only for records inside the window",
      "file": "../engine/transcript_reader.py",
      "oracle": "real",
      "find": "if on_record is not None:\n            on_record(info, rec)",
      "replace": "if on_record is not None and in_window(rec.get(\"timestamp\"), since, until):\n            on_record(info, rec)"
    },
    {
      "label": "25 schema_version left at 3",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "SCHEMA_VERSION = 4",
      "replace": "SCHEMA_VERSION = 3"
    },
    {
      "label": "26 positive control: every attachment sized zero",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "size = _rendered_size(rec)",
      "replace": "size = 0"
    },
    {
      "label": "27 shares from rounded dollars (denominator is the rounded window total)",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "window_usd=total.usd,",
      "replace": "window_usd=totals[\"usd\"],"
    },
    {
      "label": "28 shares from rounded dollars (numerator is rounded)",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "return _r(part / whole) if whole else None",
      "replace": "return _r(_r(part) / whole) if whole else None"
    },
    {
      "label": "29 explicit missing calibration path treated as no file",
      "file": "../engine/cost_ledger.py",
      "oracle": "real",
      "find": "load_calibration(path, required=explicit)",
      "replace": "load_calibration(path)"
    },
    {
      "label": "30 tokens_per_file left unrounded",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "return round(x, 3)",
      "replace": "return x"
    },
    {
      "label": "31 fixed-weight total not pulled back to the window total",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "if fixed_total > window_usd > 0:",
      "replace": "if False:"
    },
    {
      "label": "32 [control] file's calls charged in reverse order",
      "file": "../engine/fixed_weight.py",
      "oracle": "real",
      "find": "for call in calls:",
      "replace": "for call in reversed(list(calls)):",
      "expect": "survived",
      "why": "Each call's charge depends only on that call and the file's fixed sizes, which are collected before estimate runs; no charge reads another call's result. Totals are sums rounded to 6 places and counts are order-free, so reverse iteration is inert on every path the suite reaches. Scope: float addition order can move a sum in its last bits, which 6-place rounding hides unless a figure sits on a rounding boundary; the one order-dependent site is the row-5 style first-call test, which this mutant does not touch."
    }
  ]
}
