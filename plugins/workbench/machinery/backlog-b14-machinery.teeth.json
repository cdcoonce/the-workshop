{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "--with",
    "hypothesis",
    "--with",
    "numpy",
    "--with",
    "pyyaml",
    "--with",
    "graphmark>=0.10,<0.11",
    "python",
    "-m",
    "pytest",
    "-q",
    "tests/test_graph_cli_main_dispatch.py",
    "tests/test_unpromoted_memory.py",
    "tests/test_budget_burn.py",
    "tests/test_content_classifier.py",
    "tests/test_frontmatter_engine.py",
    "tests/test_context_loader.py"
  ],
  "collect_command": [
    "uv",
    "run",
    "--with",
    "pytest",
    "--with",
    "hypothesis",
    "--with",
    "numpy",
    "--with",
    "pyyaml",
    "--with",
    "graphmark>=0.10,<0.11",
    "python",
    "-m",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_graph_cli_main_dispatch.py",
    "tests/test_unpromoted_memory.py",
    "tests/test_budget_burn.py",
    "tests/test_content_classifier.py",
    "tests/test_frontmatter_engine.py",
    "tests/test_context_loader.py"
  ],
  "mutants": [
    {
      "label": "#932 --gaps falls through to stats",
      "file": "engine/graph_cli.py",
      "oracle": "real",
      "find": "    elif args.gaps:\n        if args.note",
      "replace": "    elif False:\n        if args.note"
    },
    {
      "label": "#932 --clusters wired to bridges",
      "file": "engine/graph_cli.py",
      "oracle": "real",
      "find": "        _emit(clusters(graph))",
      "replace": "        _emit(bridges(graph))"
    },
    {
      "label": "#932 --unresolved unsorted",
      "file": "engine/graph_cli.py",
      "oracle": "real",
      "find": "_emit(dict(sorted(graph.unresolved.items())))",
      "replace": "_emit(dict(graph.unresolved.items()))"
    },
    {
      "label": "#932 --hubs count not forwarded",
      "file": "engine/graph_cli.py",
      "oracle": "real",
      "find": "_emit(hubs(graph, args.hubs))",
      "replace": "_emit(hubs(graph, 10))"
    },
    {
      "label": "#933 helper accepts non-string display",
      "file": "engine/unpromoted_memory.py",
      "oracle": "real",
      "find": "if isinstance(entry, dict) and isinstance(entry.get(\"display\"), str)",
      "replace": "if isinstance(entry, dict) and \"display\" in entry"
    },
    {
      "label": "#933 helper iterates non-list input",
      "file": "engine/unpromoted_memory.py",
      "oracle": "real",
      "find": "    if not isinstance(entries, list):\n        return []\n    return [",
      "replace": "    return ["
    },
    {
      "label": "#933 unpromoted_memory_links re-inlines the filter",
      "file": "engine/unpromoted_memory.py",
      "oracle": "real",
      "find": "note: extract_broken_displays(entries)",
      "replace": "note: [e[\"display\"] for e in entries if isinstance(e, dict) and isinstance(e.get(\"display\"), str)]"
    },
    {
      "label": "#788 RATES replaced wholesale",
      "file": "engine/budget_burn.py",
      "oracle": "real",
      "find": "RATES: dict[str, tuple[float, float]] = {\n    **DEFAULT_RATES,\n    **_from_config(\"RATES\", DEFAULT_RATES),\n}",
      "replace": "RATES: dict[str, tuple[float, float]] = _from_config(\"RATES\", DEFAULT_RATES)"
    },
    {
      "label": "#788 zero budget divides",
      "file": "engine/budget_burn.py",
      "oracle": "real",
      "find": "if args.budget else \"\"",
      "replace": "if True else \"\""
    },
    {
      "label": "#1142 bare concept restored",
      "file": "engine/content_routing_defaults.py",
      "oracle": "real",
      "find": "\"figured out\", \"concept of\",",
      "replace": "\"figured out\", \"concept\","
    },
    {
      "label": "#783 scalar tags iterated",
      "file": "engine/frontmatter_engine.py",
      "oracle": "real",
      "find": "    elif not isinstance(tags, list):\n        return None  # scalar",
      "replace": "    elif False:\n        return None  # scalar"
    },
    {
      "label": "#783 validate does not report scalar tags",
      "file": "engine/frontmatter_engine.py",
      "oracle": "real",
      "find": "elif not isinstance(tags, (list, str)):",
      "replace": "elif False:"
    },
    {
      "label": "#789 checkbox markup retained",
      "file": "engine/context_loader.py",
      "oracle": "real",
      "find": "item = _CHECKBOX_RE.sub(\"\", stripped[2:].strip()).strip()",
      "replace": "item = stripped[2:].strip()"
    },
    {
      "label": "#789 uppercase X not stripped",
      "file": "engine/context_loader.py",
      "oracle": "real",
      "find": "r\"^\\[[ xX]\\](?:\\s+|$)\"",
      "replace": "r\"^\\[[ x]\\](?:\\s+|$)\""
    }
  ]
}
